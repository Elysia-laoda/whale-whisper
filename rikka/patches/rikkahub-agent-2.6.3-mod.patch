+import me.rerere.rikkahub.ui.components.nav.BackButton
+import me.rerere.rikkahub.ui.components.ui.CardGroup
+import me.rerere.rikkahub.ui.components.ui.permission.PermissionManager
+import me.rerere.rikkahub.ui.components.ui.permission.PermissionNotification
+import me.rerere.rikkahub.ui.components.ui.permission.rememberPermissionState
+import me.rerere.rikkahub.ui.theme.CustomColors
+import me.rerere.rikkahub.whale.WhaleOverlayService
+import me.rerere.rikkahub.whale.WhaleStore
+
+/**
+ * Whisper-whale widget settings: one switch starts or stops the resident overlay.
+ *
+ * The switch is the authoritative on/off: it writes [WhaleStore]'s persisted flag (so the
+ * app stops bringing the whale back on the next launch) and starts/stops the foreground
+ * service that owns the window. Restarting the app is never required.
+ */
+@Composable
+fun SettingWhalePage() {
+    val context = LocalContext.current
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+
+    var enabled by remember { mutableStateOf(WhaleStore.isEnabled(context)) }
+    var overlayAllowed by remember { mutableStateOf(WhaleOverlayService.canDraw(context)) }
+
+    // Same gate as the web/MCP servers: a foreground service needs POST_NOTIFICATIONS on 33+.
+    val permissionState = rememberPermissionState(
+        permissions = buildSet {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                add(PermissionNotification)
+            }
+        },
+    )
+    PermissionManager(permissionState = permissionState)
+
+    fun openOverlaySettings() {
+        runCatching {
+            context.startActivity(
+                Intent(
+                    Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
+                    Uri.parse("package:${context.packageName}"),
+                )
+            )
+        }
+    }
+
+    fun apply(next: Boolean) {
+        if (next && !WhaleOverlayService.canDraw(context)) {
+            // Refuse silently would look like a broken switch; send the user to the switch
+            // that actually grants it and leave our own state untouched.
+            openOverlaySettings()
+            return
+        }
+        enabled = next
+        WhaleStore.setEnabled(context, next)
+        if (next) {
+            if (WhaleStore.isHidden(context)) WhaleStore.setHidden(context, false)
+            if (!permissionState.allPermissionsGranted) {
+                permissionState.requestPermissions()
+                return
+            }
+            WhaleOverlayService.start(context)
+        } else {
+            WhaleOverlayService.stop(context)
+        }
+    }
+
+    // Coming back from the system overlay-permission page should refresh the hint.
+    LaunchedEffect(Unit) {
+        overlayAllowed = WhaleOverlayService.canDraw(context)
+    }
+
+    Scaffold(
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text(stringResource(R.string.setting_page_whale)) },
+                navigationIcon = { BackButton() },
+                scrollBehavior = scrollBehavior,
+                colors = CustomColors.topBarColors,
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+    ) { innerPadding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding)
+                .verticalScroll(rememberScrollState())
+                .padding(8.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp),
+        ) {
+            CardGroup {
+                item(
+                    headlineContent = { Text(stringResource(R.string.setting_whale_toggle)) },
+                    supportingContent = {
+                        Text(
+                            stringResource(
+                                if (enabled) R.string.setting_whale_toggle_on_desc
+                                else R.string.setting_whale_toggle_off_desc
+                            )
+                        )
+                    },
+                    leadingContent = {
+                        Icon(
+                            painter = painterResource(R.drawable.ic_whale),
+                            contentDescription = null,
+                        )
+                    },
+                    trailingContent = {
+                        Switch(checked = enabled, onCheckedChange = { apply(it) })
+                    },
+                )
+            }
+
+            if (!overlayAllowed) {
+                CardGroup {
+                    item(
+                        headlineContent = { Text(stringResource(R.string.setting_whale_permission)) },
+                        supportingContent = { Text(stringResource(R.string.setting_whale_permission_desc)) },
+                        onClick = { openOverlaySettings() },
+                    )
+                }
+            }
+
+            CardGroup {
+                item(
+                    headlineContent = { Text(stringResource(R.string.setting_whale_reset_position)) },
+                    supportingContent = { Text(stringResource(R.string.setting_whale_reset_position_desc)) },
+                    onClick = {
+                        WhaleStore.resetPosition(context)
+                        if (enabled) WhaleOverlayService.reposition(context)
+                    },
+                )
+                item(
+                    headlineContent = { Text(stringResource(R.string.setting_whale_about)) },
+                    supportingContent = { Text(stringResource(R.string.setting_whale_about_desc)) },
+                )
+            }
+        }
+    }
+}
