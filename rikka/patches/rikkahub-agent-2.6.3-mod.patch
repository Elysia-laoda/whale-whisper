+package me.rerere.rikkahub.data.files
+
+import android.content.Context
+import android.util.Log
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * Seeds the bundled WorkBuddy reference library (`assets/wb-library/`) into the app's
+ * private storage so the on-device agent can read it offline with ordinary file tools.
+ *
+ * The library is a teardown of Tencent WorkBuddy 5.7.6 (prompt templates, built-in skills,
+ * CLI prompts, agent definitions, tool registry, expert list) kept as a private reference
+ * for a self-use fork. It is NOT loaded into any prompt by itself — the wb-* skills tell
+ * the agent where it is and when to look.
+ *
+ * Layout:
+ *   assets/wb-library/<partition>/...   -> /data/data/<pkg>/files/wb-library/<partition>/...
+ *
+ * Re-copying is keyed on the app's versionCode: every APK upgrade refreshes the tree once,
+ * then the marker short-circuits later launches. The copy runs off the main thread and is
+ * best-effort — a failure only means the agent sees the previous revision.
+ */
+object WbLibrarySeeder {
+    private const val TAG = "WbLibrarySeeder"
+
+    /** Asset subtree that ships with the APK. */
+    const val ASSET_ROOT = "wb-library"
+
+    /** Directory name under the app's private files dir. */
+    const val DIR_NAME = "wb-library"
+
+    private const val VERSION_MARKER = ".asset-version"
+
+    /**
+     * Bundled skills this fork ships and auto-enables once per assistant: the four WorkBuddy
+     * reference skills that point into the library below, plus the whale widget's own skill.
+     * SkillManager seeds their directories from
+     * `assets/default-skills/` and uses this list to enable them for every assistant once.
+     */
+    val BUNDLED_SKILL_NAMES: Set<String> = setOf(
+        "wb-design-verification",
+        "wb-prompt-patterns",
+        "wb-imagegen-discipline",
+        "wb-library",
+        "whale-whisper",
+    )
+
+    /** Absolute path of the seeded library; stable for the lifetime of the package. */
+    fun targetDir(context: Context): File = File(context.filesDir, DIR_NAME)
+
+    /**
+     * Copy the bundled asset tree into [targetDir] when [version] differs from the marker
+     * written by the last successful copy.
+     *
+     * @return true when a copy ran, false when it was skipped or failed.
+     */
+    suspend fun seedIfNeeded(context: Context, version: String, force: Boolean = false): Boolean =
+        withContext(Dispatchers.IO) {
+            runCatching {
+                val target = targetDir(context)
+                val marker = File(target, VERSION_MARKER)
+                val stamped = if (marker.isFile) marker.readText().trim() else ""
+                if (!force && stamped == version) return@runCatching false
+
+                val startedAt = System.currentTimeMillis()
+                copyAssetTree(context, ASSET_ROOT, target)
+                marker.writeText(version)
+                Log.i(
+                    TAG,
+                    "seedIfNeeded: seeded $ASSET_ROOT -> ${target.absolutePath} in " +
+                        "${System.currentTimeMillis() - startedAt} ms",
+                )
+                true
+            }.onFailure {
+                Log.w(TAG, "seedIfNeeded: failed; the agent keeps the previous revision", it)
+            }.getOrDefault(false)
+        }
+
+    /**
+     * Recursively copy one asset path. AssetManager reports a directory by returning a
+     * non-empty child list and a file by returning an empty one, so an empty list means
+     * "open and copy". Empty directories cannot be represented in assets, so a read
+     * failure here only ever comes from a genuine IO problem.
+     */
+    private fun copyAssetTree(context: Context, assetPath: String, dest: File) {
+        val children = context.assets.list(assetPath).orEmpty()
+        if (children.isEmpty()) {
+            dest.parentFile?.mkdirs()
+            context.assets.open(assetPath).use { input ->
+                dest.outputStream().use { output -> input.copyTo(output) }
+            }
+            return
+        }
+        dest.mkdirs()
+        for (child in children) {
+            copyAssetTree(context, "$assetPath/$child", File(dest, child))
+        }
+    }
+}
