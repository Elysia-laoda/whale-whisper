+package me.rerere.rikkahub.whale
+
+import android.annotation.SuppressLint
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.graphics.Color
+import android.graphics.PixelFormat
+import android.graphics.drawable.GradientDrawable
+import android.os.Build
+import android.os.IBinder
+import android.provider.Settings
+import android.util.Log
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import me.rerere.rikkahub.R
+import me.rerere.rikkahub.service.ChatService
+import org.koin.android.ext.android.inject
+import kotlin.math.abs
+import kotlin.math.max
+import kotlin.math.min
+
+private const val TAG = "WhaleOverlay"
+
+/**
+ * The whisper-whale widget, RikkaHub Agent edition.
+ *
+ * A resident, draggable whale that floats above every app (SYSTEM_ALERT_WINDOW). One tap asks
+ * the running agent to stop at its next action boundary and ask 「有什么要补充的吗？」 — the same
+ * interaction contract as the WorkBuddy / ZCode / DSH editions of the widget; only the "where
+ * does the click land" plumbing differs (here: an in-process flag consumed by the generation
+ * loop).
+ */
+class WhaleOverlayService : Service() {
+
+    companion object {
+        const val ACTION_START = "me.rerere.rikkahub.action.WHALE_START"
+        const val ACTION_STOP = "me.rerere.rikkahub.action.WHALE_STOP"
+
+        /**
+         * Stop *and* remember it: used by the notification's "turn off" action, where the user
+         * is stating a preference rather than momentarily taking the window down. Without the
+         * flag flip the whale would come back on the next app start and the settings switch
+         * would disagree with reality.
+         */
+        const val ACTION_STOP_AND_DISABLE = "me.rerere.rikkahub.action.WHALE_STOP_AND_DISABLE"
+
+        /** Re-place the window at the saved (or default) corner without touching the flag. */
+        const val ACTION_REPOSITION = "me.rerere.rikkahub.action.WHALE_REPOSITION"
+
+        const val NOTIFICATION_ID = 2003
+        const val CHANNEL_ID = "whale_widget"
+
+        fun start(context: Context) {
+            ContextCompat.startForegroundService(
+                context,
+                Intent(context, WhaleOverlayService::class.java).setAction(ACTION_START),
+            )
+        }
+
+        fun stop(context: Context) {
+            context.startService(
+                Intent(context, WhaleOverlayService::class.java).setAction(ACTION_STOP),
+            )
+        }
+
+        fun stopAndDisable(context: Context) {
+            context.startService(
+                Intent(context, WhaleOverlayService::class.java).setAction(ACTION_STOP_AND_DISABLE),
+            )
+        }
+
+        /** Re-read the saved position and redraw the whale there (used after "reset position"). */
+        fun reposition(context: Context) {
+            context.startService(
+                Intent(context, WhaleOverlayService::class.java).setAction(ACTION_REPOSITION),
+            )
+        }
+
+        /** True when this app may draw the overlay. */
+        fun canDraw(context: Context): Boolean = Settings.canDrawOverlays(context)
+    }
+
+    private val chatService: ChatService by inject()
+    private val serviceScope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+
+    private lateinit var windowManager: WindowManager
+    private var whaleView: ImageView? = null
+    private var dotView: View? = null
+    private var bubbleView: TextView? = null
+    private var menuView: LinearLayout? = null
+    private var bubbleJob: Job? = null
+
+    private val density: Float get() = resources.displayMetrics.density
+    private fun dp(value: Int): Int = (value * density).toInt()
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        when (intent?.action) {
+            ACTION_STOP -> {
+                tearDown()
+                stopForeground(STOP_FOREGROUND_REMOVE)
+                stopSelf()
+                return START_NOT_STICKY
+            }
+
+            ACTION_STOP_AND_DISABLE -> {
+                WhaleStore.setEnabled(this, false)
+                tearDown()
+                stopForeground(STOP_FOREGROUND_REMOVE)
+                stopSelf()
+                return START_NOT_STICKY
+            }
+
+            ACTION_REPOSITION -> {
+                if (canDraw(this) && startForegroundCompat()) {
+                    windowManager = getSystemService(WINDOW_SERVICE) as WindowManager
+                    ensureViews()
+                }
+                return START_STICKY
+            }
+        }
+        if (!canDraw(this)) {
+            Log.w(TAG, "overlay permission missing; whale stays hidden")
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        if (!startForegroundCompat()) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        windowManager = getSystemService(WINDOW_SERVICE) as WindowManager
+        ensureViews()
+        return START_STICKY
+    }
+
+    override fun onDestroy() {
+        tearDown()
+        serviceScope.cancel()
+        super.onDestroy()
+    }
+
+    // ---------------------------------------------------------------- overlay plumbing
+
+    private fun overlayParams(): WindowManager.LayoutParams =
+        WindowManager.LayoutParams(
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT,
+        ).apply { gravity = Gravity.TOP or Gravity.START }
+
+    private fun defaultPosition(): Pair<Int, Int> {
+        val metrics = resources.displayMetrics
+        return (metrics.widthPixels - dp(84)) to (metrics.heightPixels - dp(220))
+    }
+
+    private fun clamped(x: Int, y: Int): Pair<Int, Int> {
+        val metrics = resources.displayMetrics
+        val size = dp(64)
+        return max(0, min(x, metrics.widthPixels - size)) to
+            max(0, min(y, metrics.heightPixels - size))
+    }
+
+    private fun ensureViews() {
+        if (WhaleStore.isHidden(this)) showDot() else showWhale()
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun showWhale() {
+        removeWhale()
+        removeDot()
+        val image = ImageView(this).apply {
+            setImageResource(R.drawable.ic_whale)
+            contentDescription = "补充提示挂件"
+            alpha = 0.92f
+        }
+        val params = overlayParams()
+        val saved = WhaleStore.position(this) ?: defaultPosition()
+        val start = clamped(saved.first, saved.second)
+        params.x = start.first
+        params.y = start.second
+
+        var downX = 0f
+        var downY = 0f
+        var originX = 0
+        var originY = 0
+        var dragging = false
+
+        image.setOnTouchListener { _, event ->
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downX = event.rawX
+                    downY = event.rawY
+                    originX = params.x
+                    originY = params.y
+                    dragging = false
+                    true
+                }
+
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = (event.rawX - downX).toInt()
+                    val dy = (event.rawY - downY).toInt()
+                    if (!dragging && (abs(dx) > dp(6) || abs(dy) > dp(6))) dragging = true
+                    if (dragging) {
+                        val moved = clamped(originX + dx, originY + dy)
+                        params.x = moved.first
+                        params.y = moved.second
+                        runCatching { windowManager.updateViewLayout(image, params) }
+                    }
+                    true
+                }
+
+                MotionEvent.ACTION_UP -> {
+                    if (dragging) {
+                        WhaleStore.savePosition(this, params.x, params.y)
+                        bubble("位置记住了")
+                    } else if (event.eventTime - event.downTime >= 500) {
+                        toggleMenu(params.x, params.y)
+                    } else {
+                        hideMenu()
+                        dispatch()
+                    }
+                    true
+                }
+
+                else -> false
+            }
+        }
+
+        whaleView = image
+        runCatching { windowManager.addView(image, params) }
+            .onFailure {
+                Log.e(TAG, "failed to add whale overlay", it)
+                stopSelf()
+            }
+    }
+
+    private fun showDot() {
+        removeWhale()
+        removeDot()
+        val size = dp(22)
+        val dot = View(this).apply {
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(Color.parseColor("#B33A57DE"))
+                setStroke(dp(1), Color.parseColor("#66FFFFFF"))
+            }
+        }
+        val params = overlayParams().apply {
+            width = size
+            height = size
+            val saved = WhaleStore.position(this@WhaleOverlayService) ?: defaultPosition()
+            val spot = clamped(saved.first, saved.second)
+            x = spot.first
+            y = spot.second
+        }
+        dot.setOnClickListener {
+            WhaleStore.setHidden(this, false)
+            showWhale()
+        }
+        dotView = dot
+        runCatching { windowManager.addView(dot, params) }
+    }
+
+    private fun removeWhale() {
+        whaleView?.let { runCatching { windowManager.removeView(it) } }
+        whaleView = null
+    }
+
+    private fun removeDot() {
+        dotView?.let { runCatching { windowManager.removeView(it) } }
+        dotView = null
+    }
+
+    private fun tearDown() {
+        hideMenu()
+        hideBubble()
+        removeWhale()
+        removeDot()
+    }
+
+    // ---------------------------------------------------------------- bubbles
+
+    private fun bubble(text: String, durationMs: Long = 2000L) {
+        bubbleJob?.cancel()
+        hideBubble()
+        val view = TextView(this).apply {
+            setText(text)
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            background = GradientDrawable().apply {
+                cornerRadius = dp(14).toFloat()
+                setColor(Color.parseColor("#E61E2436"))
+                setStroke(dp(1), Color.parseColor("#4D8FA8FF"))
+            }
+            setPadding(dp(14), dp(9), dp(14), dp(9))
+        }
+        val params = overlayParams().apply {
+            val whale = WhaleStore.position(this@WhaleOverlayService) ?: defaultPosition()
+            val spot = clamped(whale.first - dp(60), whale.second - dp(54))
+            x = spot.first
+            y = spot.second
+        }
+        bubbleView = view
+        runCatching { windowManager.addView(view, params) }
+        bubbleJob = serviceScope.launch {
+            delay(durationMs)
+            hideBubble()
+        }
+    }
+
+    private fun hideBubble() {
+        bubbleView?.let { runCatching { windowManager.removeView(it) } }
+        bubbleView = null
+    }
+
+    // ---------------------------------------------------------------- menu
+
+    private fun menuParams(x: Int, y: Int): WindowManager.LayoutParams {
+        val width = dp(160)
+        val metrics = resources.displayMetrics
+        return overlayParams().apply {
+            this.width = width
+            this.height = WindowManager.LayoutParams.WRAP_CONTENT
+            this.x = max(0, min(x - width + dp(64), metrics.widthPixels - width))
+            this.y = max(0, min(y, metrics.heightPixels - dp(230)))
+        }
+    }
+
+    private fun menuButton(label: String, onClick: () -> Unit): TextView =
+        TextView(this).apply {
+            setText(label)
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            setPadding(dp(14), dp(10), dp(14), dp(10))
+            isClickable = true
+            setOnClickListener {
+                hideMenu()
+                onClick()
+            }
+        }
+
+    private fun toggleMenu(x: Int, y: Int) {
+        if (menuView != null) {
+            hideMenu()
+            return
+        }
+        val column = menuColumn()
+        column.addView(menuButton("点我提问") { dispatch() })
+        column.addView(menuButton("重置位置") {
+            WhaleStore.resetPosition(this)
+            showWhale()
+            bubble("位置已复位")
+        })
+        column.addView(
+            menuButton(if (WhaleStore.isHidden(this)) "显示小鲸鱼" else "隐藏小鲸鱼") {
+                val hidden = !WhaleStore.isHidden(this)
+                WhaleStore.setHidden(this, hidden)
+                if (hidden) showDot() else showWhale()
+            },
+        )
+        column.addView(menuButton("关于") {
+            bubble("补充提示挂件 v1 · RikkaHub Agent 版\n点一下我就去问「有什么要补充的吗？」", 3200L)
+        })
+        val params = menuParams(x, y)
+        menuView = column
+        runCatching { windowManager.addView(column, params) }
+    }
+
+    private fun menuColumn(): LinearLayout = LinearLayout(this).apply {
+        orientation = LinearLayout.VERTICAL
+        background = GradientDrawable().apply {
+            cornerRadius = dp(14).toFloat()
+            setColor(Color.parseColor("#F21E2436"))
+            setStroke(dp(1), Color.parseColor("#4D8FA8FF"))
+        }
+        setPadding(dp(4), dp(6), dp(4), dp(6))
+    }
+
+    private fun hideMenu() {
+        menuView?.let { runCatching { windowManager.removeView(it) } }
+        menuView = null
+    }
+
+    // ---------------------------------------------------------------- dispatch
+
+    /** The widget's whole job: land one whisper request on a running conversation. */
+    private fun dispatch() {
+        serviceScope.launch {
+            val targets = runCatching { chatService.activeGeneratingConversations() }
+                .onFailure { Log.e(TAG, "cannot enumerate running conversations", it) }
+                .getOrDefault(emptyList())
+            when {
+                targets.isEmpty() -> bubble("现在没有正在跑的任务")
+                targets.size == 1 -> deliver(targets.first())
+                else -> showPicker(targets)
+            }
+        }
+    }
+
+    private fun showPicker(targets: List<WhaleTarget>) {
+        hideMenu()
+        val column = menuColumn()
+        column.addView(menuButton("有 " + targets.size + " 个任务在跑，点哪个？") {})
+        targets.take(5).forEach { target ->
+            column.addView(menuButton(target.title.take(18)) { deliver(target) })
+        }
+        val saved = WhaleStore.position(this) ?: defaultPosition()
+        val params = menuParams(saved.first, saved.second)
+        menuView = column
+        runCatching { windowManager.addView(column, params) }
+    }
+
+    private fun deliver(target: WhaleTarget) {
+        WhaleStore.requestWhisper(target.conversationId)
+        bubble("已通知 AI ✓", 900L)
+        serviceScope.launch {
+            delay(1000)
+            bubble("它马上就抽空来问你")
+        }
+    }
+
+    // ---------------------------------------------------------------- notification
+
+    private fun startForegroundCompat(): Boolean = try {
+        ensureChannel()
+        val notification = NotificationCompat.Builder(this, CHANNEL_ID)
+            .setSmallIcon(R.drawable.ic_whale)
+            .setContentTitle("补充提示挂件")
+            .setContentText("小鲸鱼常驻中：点一下就能给正在跑的任务补一句话")
+            .setOngoing(true)
+            .setPriority(NotificationCompat.PRIORITY_MIN)
+            .addAction(0, "关掉挂件", stopPendingIntent())
+            .build()
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+            ServiceCompat.startForeground(
+                this,
+                NOTIFICATION_ID,
+                notification,
+                ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE,
+            )
+        } else {
+            startForeground(NOTIFICATION_ID, notification)
+        }
+        true
+    } catch (e: Exception) {
+        Log.e(TAG, "failed to start foreground service", e)
+        false
+    }
+
+    private fun stopPendingIntent(): PendingIntent = PendingIntent.getService(
+        this,
+        0,
+        Intent(this, WhaleOverlayService::class.java).setAction(ACTION_STOP_AND_DISABLE),
+        PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+    )
+
+    private fun ensureChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val manager = getSystemService(NOTIFICATION_SERVICE) as NotificationManager
+        if (manager.getNotificationChannel(CHANNEL_ID) != null) return
+        manager.createNotificationChannel(
+            NotificationChannel(
+                CHANNEL_ID,
+                "补充提示挂件",
+                NotificationManager.IMPORTANCE_MIN,
+            ).apply { description = "小鲸鱼挂件的常驻通知" },
+        )
+    }
+}
diff --git a/app/src/main/java/me/rerere/rikkahub/whale/WhaleStore.kt b/app/src/main/java/me/rerere/rikkahub/whale/WhaleStore.kt
new file mode 100644
index 00000000..53bea51d
--- /dev/null
+++ b/app/src/main/java/me/rerere/rikkahub/whale/WhaleStore.kt
@@ -0,0 +1,94 @@
+package me.rerere.rikkahub.whale
+
+import android.content.Context
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Shared state for the whisper-whale widget (the RikkaHub Agent edition of
+ * https://github.com/Elysia-laoda/whale-whisper).
+ *
+ * The widget itself is a system overlay ([WhaleOverlayService]); the agent side is a flag
+ * this object holds per conversation. When the user taps the whale we set the flag, and
+ * [me.rerere.rikkahub.service.ChatService] consumes it at the next model-request boundary
+ * inside the tool loop — "the next action boundary" of the shared design contract — by
+ * appending one user-role instruction telling the agent to ask its one question.
+ *
+ * All state is in memory except the widget's own UI preferences (position / hidden /
+ * enabled), which persist in SharedPreferences.
+ */
+object WhaleStore {
+    private const val PREFS = "whale_widget"
+    private const val KEY_ENABLED = "enabled"
+    private const val KEY_HIDDEN = "hidden"
+    private const val KEY_X = "overlay_x"
+    private const val KEY_Y = "overlay_y"
+
+    /**
+     * Injected as a user message at the next model request. Kept verbatim in one place so the
+     * four host editions of the widget share the same interaction contract: ask immediately,
+     * one question, no options, fold the answer into the plan, say what changed, ask once.
+     */
+    const val WHISPER_INSTRUCTION: String =
+        "【补充提示挂件】用户点了小鲸鱼，想给正在跑的任务补一句话。请**立刻**（不要等任务做完、不要攒到最后）" +
+            "调用 ask_user 工具，只问一个问题：「有什么要补充的吗？」。header 用「补充提示」，不要提供选项" +
+            "（留空让用户自由输入）。拿到回答后，把补充内容纳入当前计划再继续，并用一句话说明你据此调整了什么。" +
+            "同一次点击只处理一次；用户跳过或没回答就按原计划继续，不要反复追问。"
+
+    /** conversation id (string form) -> wall-clock ms of the last tap. */
+    private val pending = ConcurrentHashMap<String, Long>()
+
+    fun requestWhisper(conversationId: String) {
+        pending[conversationId] = System.currentTimeMillis()
+    }
+
+    fun hasPending(conversationId: String): Boolean = pending.containsKey(conversationId)
+
+    /** True when this request is still waiting and was just claimed by the caller. */
+    fun consume(conversationId: String): Boolean = pending.remove(conversationId) != null
+
+    /** Drop a request that can no longer be delivered (conversation gone / cancelled). */
+    fun cancel(conversationId: String) {
+        pending.remove(conversationId)
+    }
+
+    fun pendingCount(): Int = pending.size
+
+    private fun prefs(context: Context) =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    var Context.whaleEnabled: Boolean
+        get() = prefs(this).getBoolean(KEY_ENABLED, true)
+        set(value) {
+            prefs(this).edit().putBoolean(KEY_ENABLED, value).apply()
+        }
+
+    fun isEnabled(context: Context): Boolean = context.whaleEnabled
+
+    fun setEnabled(context: Context, enabled: Boolean) {
+        context.whaleEnabled = enabled
+    }
+
+    fun isHidden(context: Context): Boolean = prefs(context).getBoolean(KEY_HIDDEN, false)
+
+    fun setHidden(context: Context, hidden: Boolean) {
+        prefs(context).edit().putBoolean(KEY_HIDDEN, hidden).apply()
+    }
+
+    /** Saved overlay position, or null when the whale has never been dragged. */
+    fun position(context: Context): Pair<Int, Int>? {
+        val p = prefs(context)
+        if (!p.contains(KEY_X) || !p.contains(KEY_Y)) return null
+        return p.getInt(KEY_X, 0) to p.getInt(KEY_Y, 0)
+    }
+
+    fun savePosition(context: Context, x: Int, y: Int) {
+        prefs(context).edit().putInt(KEY_X, x).putInt(KEY_Y, y).apply()
+    }
+
+    fun resetPosition(context: Context) {
+        prefs(context).edit().remove(KEY_X).remove(KEY_Y).apply()
+    }
+}
+
+/** A conversation the widget can dispatch into. */
+data class WhaleTarget(val conversationId: String, val title: String)
